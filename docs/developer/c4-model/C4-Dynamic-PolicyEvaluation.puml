@startuml C4-Dynamic-PolicyEvaluation
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false

title Dynamic — Short-lived credentials and policy evaluation

actor "Caller" as caller
participant "IAM Application\nShort-lived credentials + Policy :9100" as api <<java>>
participant "PolicyEngine\ndomain service" as engine <<java>>
database "Metadata DB" as db <<db>>

caller -> api: 1. POST /api/v1/shortLivedCredentials\n(roleArn, sessionName)
api -> db: 2. Load Role + impersonation policy
db --> api: 3. Role row
api -> engine: 4. Evaluate impersonation policy\n(caller principal)
engine --> api: 5. Allow / Deny + ReasonCode
alt Deny
  api --> caller: 6. 403 Forbidden
else Allow
  api -> db: 7. Save ShortLivedCredential
  api -> api: 8. JwtEncoder → temporary JWT
  api -> db: 9. Append DataAccessLog (optional)
  api --> caller: 10. 200 { accessToken, expiresAt }
end

caller -> api: 11. Protected API call\n(Bearer JWT or session)
api -> db: 12. Load attached AllowPolicies
api -> engine: 13. Evaluate(principal, permission, resource)
engine -> engine: 14. Explicit Deny > Allow > implicit Deny
engine --> api: 15. AccessDecision
api -> db: 16. Append audit records
api --> caller: 17. 200 or 403

note right of engine
  Glossary: Deny > Allow > Implicit Deny
  ReasonCode on every decision
end note

@enduml
