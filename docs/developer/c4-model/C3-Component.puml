@startuml C3-Component
!theme C4_blue_new from https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/themes
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram (C3) — Explore IAM (backend + frontends)

Container_Boundary(iam_app, "IAM Application (Spring Boot :9100)") {

    Container_Boundary(console, "IAM Console") {
        Component(console_shell, "App Shell", "Angular 22", "Routes: home, clients, login, verify, security/totp")
        Component(clients_ui, "OAuth Clients UI", "Angular", "/oauth-clients list + create wizard")
        Component(login_ui, "Login / MFA UI", "Angular", "/login · /login/verify · OTT · TOTP · Passkey")
        Component(totp_enroll_ui, "TOTP Enroll UI", "Angular", "/security/totp QR + confirm")
        Component(http_client, "HTTP Client", "Angular HttpClient", "REST + CSRF (X-XSRF-TOKEN)")
    }

    Container_Boundary(identity, "Identity Module") {
        Component(user_ctrl, "UserController", "controller", "/api/v1/users")
        Component(group_ctrl, "GroupController", "controller", "/api/v1/groups")
        Component(role_ctrl, "RoleController", "controller", "/api/v1/roles")
        Component(login_ctx, "LoginContextController", "controller", "/api/login · /mfa-options")
        Component(totp_ctrl, "TotpController", "controller", "/api/v1/totp enroll/status")
        Component(totp_challenge, "TotpChallengeController", "controller", "POST /login/totp → FACTOR_TOTP")
        Component(identity_svc, "Identity Services", "service", "UserService / GroupService / RoleService / TotpService")
        Component(identity_dom, "Identity Domain", "domain", "User, Group, Role, RoleBinding, TotpCredential")
        Component(identity_infra, "Identity Infra", "infra", "JPA, WebSecurityConfig MFA factors, WebAuthn JDBC")
    }

    Container_Boundary(policy, "Policy Module") {
        Component(policy_ctrl, "PolicyController", "controller", "/api/v1/allowPolicies")
        Component(perm_ctrl, "PermissionController", "controller", "/api/v1/permissions")
        Component(policy_svc, "PolicyService", "service", "Create allow policy / binding / evaluate")
        Component(policy_dom, "Policy Domain", "domain", "AllowPolicy, Permission, PolicyEngine")
        Component(policy_infra, "Policy Infra", "infra", "JpaPolicyRepository, converters")
    }

    Container_Boundary(sts, "Short-lived credentials Module") {
        Component(sts_ctrl, "StsController", "controller", "/api/v1/shortLivedCredentials")
        Component(sts_svc, "ShortLivedCredentialService", "service", "Temporary JWT")
        Component(sts_dom, "Short-lived credentials Domain", "domain", "ShortLivedCredential")
        Component(sts_infra, "Short-lived credentials Infra", "infra", "JpaShortLivedCredentialRepository")
    }

    Container_Boundary(federation, "Federation Module") {
        Component(fed_ctrl, "OAuthClientController", "controller", "/api/v1/oauthClients")
        Component(fed_svc, "Federation Services", "service", "OAuthClientService / FederationLinkService\nhandleUserDeletionRequestedEvent removes links")
        Component(fed_dom, "Federation Domain", "domain", "OAuthClient, FederatedIdentity")
        Component(fed_infra, "Federation Infra", "infra", "SAS config, JWK persistence,\nFederatedLoginService (OAuth2UserService)")
    }

    Container_Boundary(scim, "SCIM Module") {
        Component(scim_ctrl, "SCIM Controllers", "controller", "/scim/v2/Users · Groups · discovery\napplication/scim+json, ETag / If-Match")
        Component(scim_prov_svc, "ScimProvisioningService", "service", "Inbound create / replace / PATCH / delete")
        Component(scim_push, "ScimPushListener + ScimPushService", "service", "@ApplicationModuleListener → idempotent push")
        Component(scim_dom, "SCIM Domain", "domain", "ProvisioningTarget, ProvisionedAccount, ScimTargetGateway")
        Component(scim_infra, "SCIM Infra", "infra", "ScimSecurityConfig (write:iam_scim), ScimFilterTranslator,\nScimTargetClient (RestClient + OAuth2 client_credentials, @Retryable)")
    }

    Container_Boundary(audit, "Audit Module") {
        Component(audit_ctrl, "AuditController", "controller", "/api/v1/adminActivities")
        Component(audit_svc, "AdminActivityRecorder + AuditService", "service", "@EventListener handleXxxEvent (sync, same tx)\n→ AdminActivity + DataAccessLog")
        Component(audit_dom, "Audit Domain", "domain", "AdminActivity, DataAccessLog")
        Component(audit_infra, "Audit Infra", "infra", "JpaAuditRepository, auth listener")
    }

    Container_Boundary(common, "Common") {
        Component(common_sec, "Method Security", "security", "@PreAuthorize, SecurityRoles")
        Component(common_vo, "Shared model VOs", "domain.model", "ResourceName, Permission, Resource, Effect")
    }
}

ContainerDb_Ext(metadata_db, "Metadata Database", "H2 / PostgreSQL", "Liquibase 0.1.xml")
System_Ext(external_idp, "External IdP", "Google / GitHub", "Optional OAuth2 Login")
System_Ext(enterprise_idp, "Enterprise IdP", "Okta / Entra ID", "SCIM 2.0 client")
System_Ext(explore_ai_scim, "Explore AI SCIM", "/scim/v2/Users", "Provisioning Target")

Rel(console_shell, clients_ui, "Routes")
Rel(console_shell, login_ui, "Routes")
Rel(console_shell, totp_enroll_ui, "Routes")
Rel(clients_ui, http_client, "REST")
Rel(login_ui, http_client, "Form POST /login · OTT · WebAuthn · /login/totp")
Rel(totp_enroll_ui, http_client, "REST /api/v1/totp")

Rel(http_client, user_ctrl, "HTTPS /api/v1/users")
Rel(http_client, group_ctrl, "HTTPS /api/v1/groups")
Rel(http_client, role_ctrl, "HTTPS /api/v1/roles")
Rel(http_client, login_ctx, "HTTPS /api/login")
Rel(http_client, totp_ctrl, "HTTPS /api/v1/totp")
Rel(http_client, policy_ctrl, "HTTPS /api/v1/allowPolicies")
Rel(http_client, perm_ctrl, "HTTPS /api/v1/permissions")
Rel(http_client, fed_ctrl, "HTTPS /api/v1/oauthClients")
Rel(http_client, audit_ctrl, "HTTPS /api/v1/adminActivities")
Rel(http_client, sts_ctrl, "HTTPS /api/v1/shortLivedCredentials")

Rel(user_ctrl, identity_svc, "Delegates")
Rel(group_ctrl, identity_svc, "Delegates")
Rel(role_ctrl, identity_svc, "Delegates")
Rel(totp_ctrl, identity_svc, "Delegates")
Rel(totp_challenge, identity_svc, "Verifies TOTP")
Rel(login_ctx, identity_svc, "TOTP status")
Rel(login_ctx, identity_infra, "Passkey lookup")
Rel(identity_svc, identity_dom, "Rich model")
Rel(identity_svc, identity_infra, "Persists")
Rel(policy_ctrl, policy_svc, "Delegates")
Rel(perm_ctrl, policy_svc, "Delegates")
Rel(policy_svc, policy_dom, "PolicyEngine.evaluate")
Rel(policy_svc, policy_infra, "Persists")
Rel(sts_ctrl, sts_svc, "Delegates")
Rel(sts_svc, sts_dom, "Creates short-lived credential")
Rel(sts_svc, policy_dom, "Impersonation policy (via Role)")
Rel(sts_svc, audit_svc, "RoleAssumedEvent (sync)")
Rel(fed_ctrl, fed_svc, "Delegates")
Rel(fed_svc, fed_infra, "SAS RegisteredClient")
Rel(audit_ctrl, audit_svc, "Delegates")
Rel(audit_svc, audit_dom, "Append-only")
Rel(audit_svc, audit_infra, "Persists")

Rel(enterprise_idp, scim_ctrl, "SCIM 2.0 Bearer", "HTTPS")
Rel(scim_ctrl, scim_prov_svc, "Delegates")
Rel(scim_prov_svc, identity_svc, "Provision / deactivate / delete User, Group")
Rel(identity_svc, scim_push, "Domain events after commit\n(UserProvisionedEvent, UserDeletedEvent, GroupMembershipChangedEvent …)")
Rel(identity_svc, audit_svc, "Domain events (sync)\n(UserDeactivatedEvent, GroupCreatedEvent, RoleCreatedEvent …)")
Rel(identity_svc, fed_svc, "UserDeletionRequestedEvent (sync)")
Rel(policy_svc, audit_svc, "AllowPolicyCreatedEvent, PolicyAttachedEvent,\nPermissionCreatedEvent, AccessEvaluatedEvent (sync)")
Rel(fed_svc, audit_svc, "OAuthClientRegisteredEvent,\nOAuthClientScopesChangedEvent (sync)")
Rel(identity_infra, fed_infra, "oauth2Login userService\n(OAuth2UserService interface)")
Rel(scim_push, scim_dom, "Target + account bookkeeping")
Rel(scim_push, scim_infra, "ScimTargetGateway")
Rel(scim_infra, explore_ai_scim, "Push users", "SCIM 2.0 / HTTPS")
Rel(scim_infra, metadata_db, "JPA + event_publication")
Rel(identity_infra, metadata_db, "JPA / SQL")
Rel(policy_infra, metadata_db, "JPA / SQL")
Rel(sts_infra, metadata_db, "JPA / SQL")
Rel(fed_infra, metadata_db, "JPA / JDBC")
Rel(audit_infra, metadata_db, "JPA / SQL")
Rel(identity_infra, external_idp, "oauth2Login (optional)", "OIDC")
Rel(common_sec, user_ctrl, "RBAC")
Rel(common_sec, group_ctrl, "RBAC")
Rel(common_sec, role_ctrl, "RBAC")
Rel(common_sec, policy_ctrl, "RBAC")
Rel(common_sec, perm_ctrl, "RBAC")
Rel(common_sec, fed_ctrl, "RBAC")
Rel(common_sec, audit_ctrl, "RBAC")

SHOW_LEGEND()

@enduml
