@startuml C2-Container
!theme C4_blue_new from https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/themes
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram (C2) — Explore IAM

Person(end_user, "End User", "SSO into business apps (web or iOS)")
Person(admin, "IAM Administrator", "Console operations")
Person(developer, "App Developer", "Integration & debugging")

System_Boundary(explore_iam, "Explore IAM") {
    Container(iam_app, "IAM Application", "Spring Boot 4.1 / Java 25 + Angular 22 SPA", "Single deployable :9100 — Console static + REST + OIDC Provider (SAS)\nSeed public clients: explore-ai-ios / explore-chat-ios (PKCE required)\nAccess + ID tokens carry email/profile claims\nSCIM 2.0 server /scim/v2 + outbound SCIM push (Spring Modulith events)")
    ContainerDb(metadata_db, "Metadata Database", "H2 (local) / PostgreSQL (target)", "Users, groups, roles, policies, clients, signing keys, audit\nprovisioning targets, provisioned accounts, event publications")
}

System_Ext(google_idp, "Google IdP", "External federation")
System_Ext(github_idp, "GitHub IdP", "External federation")
System_Ext(enterprise_idp, "Enterprise IdP", "Okta / Microsoft Entra ID", "SCIM 2.0 client (client_credentials, write:iam_scim)")
System_Ext(apps, "Business Applications", "Explore AI / Explore Chat / Shopping / Low Code\nWeb confidential clients + native public PKCE clients", "OIDC Relying Parties")
System_Ext(explore_ai_scim, "Explore AI SCIM", "/scim/v2/Users", "Provisioning Target (write:ai_scim)")

Rel(end_user, apps, "Uses", "HTTPS / native")
Rel(end_user, iam_app, "Login / consent", "HTTPS / OIDC / PKCE")
Rel(admin, iam_app, "Console + management API", "HTTPS :9100")
Rel(developer, iam_app, "Register clients / REST", "HTTPS :9100")

Rel(apps, iam_app, "Authorization Code (+ PKCE) / Token / JWKS", "OIDC / HTTPS")
Rel(iam_app, metadata_db, "Read / write", "JDBC / Liquibase")
Rel(iam_app, google_idp, "OAuth2 Login (optional)", "OIDC")
Rel(iam_app, github_idp, "OAuth2 Login (optional)", "OAuth 2.0")
Rel(enterprise_idp, iam_app, "Users / Groups CRUD + PATCH", "SCIM 2.0 / HTTPS")
Rel(iam_app, explore_ai_scim, "Push users (create / replace / deactivate / delete)", "SCIM 2.0 / HTTPS + Bearer")

SHOW_LEGEND()

@enduml
