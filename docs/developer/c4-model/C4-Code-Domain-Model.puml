@startuml C4-Code-Domain-Model
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

title Code diagram (C4) — Domain model (Google Cloud IAM naming)
hide empty members

legend right
  |= Stereotype |= Meaning |
  | <<Abstract>> | 抽象基类 |
  | <<AggregateRoot>> | 聚合根 |
  | <<Entity>> | 实体 |
  | <<ValueObject>> | 值对象 |
  | <<Enum>> | 枚举 |
  | <<DomainService>> | 领域服务 |
  | <<DomainEvent>> | 领域事件 |
endlegend

package "Domain Kernel" as pkg_kernel {
  class AbstractImmutable <<Abstract>> {
    +id: String
    +createdAt: Instant @CreationTimestamp
  }
  class AbstractEntity <<Abstract>> {
    +updatedAt: Instant @UpdateTimestamp
    +version: long
    # touch()
  }
  class AbstractEmbeddable <<Abstract>>
  class AbstractNamedEntity <<Abstract>> {
    +name: String
  }
  class AbstractAuditEvent <<Abstract>> {
    --
    +getOccurredAt()
    +occurredBefore(instant)
    +occurredAfter(instant)
  }
  class DomainStrings {
    +{static} requireNonBlank(value, fieldName)
  }
}

AbstractEntity --|> AbstractImmutable
AbstractNamedEntity --|> AbstractEntity
AbstractAuditEvent --|> AbstractImmutable

package "Common" as pkg_common {
  class ResourceName <<ValueObject>> {
    +value: String
    --
    +{static} createUserResourceName(username)
    +{static} createRoleResourceName(roleName)
  }
  class "Permission" as Permission <<ValueObject>> {
    +value: String
    --
    +matchesPermission(requested)
  }
  class Resource <<ValueObject>> {
    +value: String
    --
    +matchesResource(requested)
  }
  class Scope <<ValueObject>> {
    +value: String
    --
    +{static} parseScope(raw)
    +isOidcStandard()
  }
  class PrincipalId <<ValueObject>> {
    +value: String
    --
    +{static} generatePrincipalId()
  }
  class ReasonCode <<ValueObject>> {
    +value: String
  }
  enum Effect <<Enum>> {
    ALLOW
    DENY
    --
    +{static} parseEffect(raw)
  }
}

ResourceName --|> AbstractEmbeddable
Permission --|> AbstractEmbeddable
Resource --|> AbstractEmbeddable
Scope --|> AbstractEmbeddable
PrincipalId --|> AbstractEmbeddable
ReasonCode --|> AbstractEmbeddable

package "Identity" as pkg_identity {
  class User <<AggregateRoot>> {
    +username: String
    +email: String
    +displayName: String
    +externalId: ExternalId
    +passwordHash: String
    +enabled: boolean
    --
    +{static} createUser(username, email, passwordHash)
    +{static} createFederatedUser(provider, subject, email)
    +{static} provisionUser(username, email, displayName, externalId)
    +disableUser(): boolean
    +enableUser(): boolean
    +resetPassword(passwordHash)
    +changeEmail(email)
    +updateProfile(username, email, displayName): boolean
    +changeExternalId(externalId): boolean
    +assignRole(roleId): boolean
    +unassignRole(roleId): boolean
    +hasRole(roleId)
    +assignedRoleIds()
  }
  class Group <<AggregateRoot>> {
    +name: String
    +externalId: ExternalId
    --
    +{static} createGroup(name)
    +{static} provisionGroup(name, externalId)
    +getResourceName()
    +renameGroup(name): boolean
    +changeExternalId(externalId): boolean
    +addMember(userId): boolean
    +removeMember(userId): boolean
    +replaceMembers(userIds): MembershipChange
    +hasMember(userId)
    +memberUserIds()
  }
  class ExternalId <<ValueObject>> {
    +value: String
  }
  class UserProvisionedEvent <<DomainEvent>> {
    +userId: String
  }
  class UserProfileChangedEvent <<DomainEvent>> {
    +userId: String
  }
  class UserDeactivatedEvent <<DomainEvent>> {
    +userId: String
  }
  class UserReactivatedEvent <<DomainEvent>> {
    +userId: String
  }
  class UserPasswordResetEvent <<DomainEvent>> {
    +userId: String
  }
  class UserRoleAssignedEvent <<DomainEvent>> {
    +userId: String
    +roleId: String
  }
  class UserRoleUnassignedEvent <<DomainEvent>> {
    +userId: String
    +roleId: String
  }
  class UserDeletionRequestedEvent <<DomainEvent>> {
    +userId: String
  }
  class UserDeletedEvent <<DomainEvent>> {
    +userId: String
  }
  class GroupCreatedEvent <<DomainEvent>> {
    +groupId: String
  }
  class GroupProfileChangedEvent <<DomainEvent>> {
    +groupId: String
  }
  class GroupMembershipChangedEvent <<DomainEvent>> {
    +groupId: String
    +addedUserIds: Set<String>
    +removedUserIds: Set<String>
  }
  class GroupDeletedEvent <<DomainEvent>> {
    +groupId: String
  }
  class RoleCreatedEvent <<DomainEvent>> {
    +roleId: String
  }
  class GroupMember <<Entity>> {
    +userId: String
    --
    +userId()
  }
  class RoleBinding <<Entity>> {
    +userId: String
    +roleId: String
    --
    +roleId()
  }
  class Role <<AggregateRoot>> {
    +name: String
    +resourceName: ResourceName
    +trustPolicy: ImpersonationPolicy
    --
    +{static} createRole(name, trustPolicy)
    +{static} createRole(name, trustPolicyJson)
    +authority()
  }
  class ImpersonationPolicy <<ValueObject>> {
    +json: String
    --
    +{static} createPermissiveImpersonationPolicy()
  }
  class TotpCredential <<AggregateRoot>> {
    +userId: String
    +secretCiphertext: String
    +enabled: boolean
    --
    +{static} createTotpCredential(userId, secretCiphertext)
    +enableTotp()
    +disableTotp()
    +rotateSecret(secretCiphertext)
  }
  class WebAuthnCredential <<ValueObject>> {
    +credentialId: byte[]
    +userHandle: byte[]
  }
}

note right of WebAuthnCredential
  Persisted by Spring Security JDBC
  PublicKeyCredential / UserCredential repos
end note

User --|> AbstractEntity
Group --|> AbstractEntity
Role --|> AbstractNamedEntity
TotpCredential --|> AbstractEntity
Group "1" *-- "0..*" GroupMember : members
User "1" *-- "0..*" RoleBinding : roleBindings
User "1" o-- "0..1" TotpCredential : optional
User "1" o-- "0..*" WebAuthnCredential : passkeys
Role --> ResourceName
Role --> ImpersonationPolicy
ExternalId --|> AbstractEmbeddable
User --> ExternalId
Group --> ExternalId
UserProvisionedEvent ..> User : userId
UserDeletionRequestedEvent ..> User : userId
GroupMembershipChangedEvent ..> Group : groupId
RoleCreatedEvent ..> Role : roleId

package "Provisioning" as pkg_provisioning {
  class ProvisioningTarget <<AggregateRoot>> {
    +name: String
    +baseUrl: String
    +registrationId: String
    +enabled: boolean
    +assignmentGroupId: String
    --
    +{static} createProvisioningTarget(name, baseUrl, registrationId, assignmentGroupId)
    +reconfigure(baseUrl, registrationId, assignmentGroupId)
    +enableTarget()
    +disableTarget()
    +requiresAssignment()
    +recordProvisionedAccount(iamUserId, remoteId, version)
    +forgetProvisionedAccount(iamUserId)
    +findProvisionedAccount(iamUserId)
  }
  class ProvisionedAccount <<Entity>> {
    +iamUserId: String
    +remoteId: String
    +lastSyncedVersion: long
    --
    +isSyncedAt(version)
  }
}

ProvisioningTarget --|> AbstractNamedEntity
ProvisioningTarget "1" *-- "0..*" ProvisionedAccount : accounts
ProvisionedAccount ..> User : iamUserId
ProvisioningTarget ..> Group : assignmentGroupId
ProvisioningTarget ..> UserProvisionedEvent : reacts via listener
ProvisioningTarget ..> GroupMembershipChangedEvent : reacts via listener

package "Policy" as pkg_policy {
  class AllowPolicy <<AggregateRoot>> {
    +name: String
    +statements: List<PolicyStatement>
    --
    +{static} createAllowPolicy(name, statements)
  }
  class PolicyStatement <<ValueObject>> {
    +effect: Effect
    +actions: Set<Permission>
    +resources: Set<Resource>
    --
    +{static} createPolicyStatement(effect, actions, resources)
    +matchesPermissionAndResource(action, resource)
  }
  class PolicyBinding <<AggregateRoot>> {
    +policyId: String
    +principalArn: ResourceName
    --
    +{static} createPolicyBinding(policyId, principalArn)
  }
  class "Permission" as PermissionCatalogEntry <<AggregateRoot>> {
    +code: String
    +oauthScope: Scope
    +module: String
    +action: Permission
    +resource: Resource
    +description: String
    --
    +{static} createPermission(code, oauthScope, module, action, resource, description)
    +matchesOAuthScope(scope)
  }
  class AccessTuple <<ValueObject>> {
    +principalId: PrincipalId
    +action: Permission
    +resource: Resource
  }
  class AccessDecision <<ValueObject>> {
    +effect: Effect
    +reasonCode: ReasonCode
    --
    +isAllowed()
  }
  class PolicyEngine <<DomainService>> {
    +evaluate(context, policies)
  }
  class AllowPolicyCreatedEvent <<DomainEvent>> {
    +policyId: String
  }
  class PolicyAttachedEvent <<DomainEvent>> {
    +policyBindingId: String
  }
  class PermissionCreatedEvent <<DomainEvent>> {
    +code: String
  }
  class AccessEvaluatedEvent <<DomainEvent>> {
    +principalId: String
    +action: String
    +resource: String
    +effect: Effect
    +reasonCode: String
  }
}

AllowPolicy --|> AbstractNamedEntity
PolicyBinding --|> AbstractImmutable
PermissionCatalogEntry --|> AbstractImmutable
AllowPolicy "1" *-- "1..*" PolicyStatement : statements
PolicyBinding --> AllowPolicy : references policyId
PolicyBinding --> ResourceName
PermissionCatalogEntry --> Permission
PermissionCatalogEntry --> Resource
PermissionCatalogEntry --> Scope : oauthScope
AccessTuple --> PrincipalId
AccessTuple --> Permission
AccessTuple --> Resource
AccessDecision --> Effect
AccessDecision --> ReasonCode
PolicyEngine ..> AllowPolicy : reads
PolicyEngine ..> AccessDecision : returns
PermissionCatalogEntry ..> PolicyEngine : catalog for Permission/Resource

package "Short-lived credentials" as pkg_sts {
  class ShortLivedCredential <<AggregateRoot>> {
    +roleArn: ResourceName
    +sessionName: String
    +callerPrincipal: String
    +expiresAt: Instant
    --
    +{static} createShortLivedCredential(roleArn, sessionName, callerPrincipal, expiresAt)
    +isExpired(now)
  }
  class RoleAssumedEvent <<DomainEvent>> {
    +roleId: String
  }
}

ShortLivedCredential --|> AbstractImmutable
ShortLivedCredential --> ResourceName
RoleAssumedEvent ..> Role : roleId

package "Federation" as pkg_federation {
  class OAuthClient <<AggregateRoot>> {
    +clientId: ClientId
    +redirectUris: Set<RedirectUri>
    +scopes: Set<String>
    --
    +{static} createOAuthClient(...)
    +{static} createBootstrapOAuthClient(...)
    +{static} createPublicBootstrapOAuthClient(...)
    +{static} restoreOAuthClient(...)
    +isPublicClient()
    +replaceScopes(scopes)
  }
  class FederatedIdentity <<AggregateRoot>> {
    +userId: String
    +provider: String
    +externalSubject: String
    --
    +{static} createFederatedIdentity(userId, provider, externalSubject)
  }
  class ClientId <<ValueObject>> {
    +value: String
  }
  class RedirectUri <<ValueObject>> {
    +value: String
  }
  class OAuthClientRegisteredEvent <<DomainEvent>> {
    +clientId: String
  }
  class OAuthClientScopesChangedEvent <<DomainEvent>> {
    +clientId: String
  }
  note right of OAuthClient
    Public clients (explore-ai-ios / explore-chat-ios):
    requireProofKey; custom-scheme RedirectUri
    (com.explore.*://oauth/callback) allowed.
    Scopes persist via SAS oauth2_registered_client.scopes.
  end note
}

FederatedIdentity --|> AbstractImmutable
OAuthClient --> ClientId
OAuthClient --> RedirectUri
FederatedIdentity ..> User : links

package "Audit" as pkg_audit {
  class AuditActor <<ValueObject>> {
    +value: String
  }
  class AuditTarget <<ValueObject>> {
    +type: String
    +targetId: String
    --
    +matches(type, targetId)
  }
  class AdminActivity <<AggregateRoot>> {
    +actor: AuditActor
    +action: String
    +target: AuditTarget
    +outcome: AuditOutcome
    --
    +{static} recordAdminActivity(actor, action, target, outcome)
    +{static} recordSignInActivity(actor, outcome)
    +wasSuccessful()
    +wasFailure()
    +involvesActor(candidate)
    +targets(candidate)
  }
  class DataAccessLog <<AggregateRoot>> {
    +principalId: PrincipalId
    +action: Permission
    +resource: Resource
    +effect: Effect
    +reasonCode: ReasonCode
    --
    +{static} recordDataAccessLog(principalId, action, resource, effect, reasonCode)
    +{static} recordAccessDecisionLog(principalId, action, resource, effect, reasonCode)
    +isAllowed()
    +isDenied()
    +wasExplicitDeny()
    +wasImplicitDeny()
  }
  enum AuditOutcome <<Enum>> {
    SUCCESS
    FAILURE
  }
}

AdminActivity --|> AbstractAuditEvent
DataAccessLog --|> AbstractAuditEvent
AdminActivity --> AuditActor
AdminActivity --> AuditTarget
AdminActivity --> AuditOutcome
DataAccessLog --> PrincipalId
DataAccessLog --> Permission
DataAccessLog --> Resource
DataAccessLog --> Effect
DataAccessLog --> ReasonCode
DataAccessLog ..> AccessDecision : records
AccessEvaluatedEvent ..> DataAccessLog : handled into
AdminActivity ..> UserDeletedEvent : handled into

note as N_LAYERS
  Layering (per module): controller → service → domain ← infra
  Package titles are business domains, not Java packages.
  Kernel: @CreationTimestamp / @UpdateTimestamp; Bean Validation on fields.
  Persisted string VOs: @Embeddable (ResourceName, Permission, Resource, …).
  restoreOAuthClient: OAuthClient only (non-JPA aggregate).
  Domain events: records named *Event, ids only (no PII); published by
  application services via ApplicationEventPublisher after the state
  change; handled by @EventListener handleXxxEvent on the consuming
  service (audit, federation) in the same transaction; SCIM push uses
  @ApplicationModuleListener after commit. SCIM types stay in com.iam.scim.
  Preferred Terms: docs/Glossary.md
end note

@enduml
