@startuml C4-Code-Domain-Model
!include style-zinc.puml
title Code diagram (C4) — Domain model (aligned to com.iam.*.domain)
hide empty members

legend right
  |= 标题色 |= Type |
  | <color:#334155>Abstract</color> | 抽象基类 |
  | <color:#064E3B>AggregateRoot</color> | 聚合根 |
  | <color:#1E3A8A>Entity</color> | 实体 |
  | <color:#9A3412>ValueObject</color> | 值对象 |
  | <color:#78350F>Enum</color> | 枚举 |
  | <color:#3730A3>DomainService</color> | 领域服务 |
endlegend

package "com.iam.common.domain.base" as pkg_kernel {
  class AbstractImmutable <<Abstract>> {
    +id: String
    +createdAt: Instant
  }
  class AbstractEntity <<Abstract>> {
    +updatedAt: Instant
    +version: long
  }
  class AbstractEmbeddable <<Abstract>>
  class AbstractNamedEntity <<Abstract>> {
    +name: String
  }
  class AbstractAuditEvent <<Abstract>> {
    --
    +getOccurredAt()
    +occurredBefore(instant)
    +occurredAfter(instant)
  }
  class DomainStrings {
    +{static} requireNonBlank(value, fieldName)
  }
}

AbstractEntity --|> AbstractImmutable
AbstractNamedEntity --|> AbstractEntity
AbstractAuditEvent --|> AbstractImmutable

package "com.iam.common.domain.vo" as pkg_common {
  class Arn <<ValueObject>> {
    +value: String
    --
    +{static} user(username)
    +{static} role(roleName)
  }
  class Action <<ValueObject>> {
    +value: String
    --
    +matches(requested)
  }
  class Resource <<ValueObject>> {
    +value: String
    --
    +matches(requested)
  }
  class Scope <<ValueObject>> {
    +value: String
    --
    +{static} of(raw)
    +isOidcStandard()
  }
  class PrincipalId <<ValueObject>> {
    +value: String
    --
    +{static} generate()
  }
  class ReasonCode <<ValueObject>> {
    +value: String
  }
  enum Effect <<Enum>> {
    ALLOW
    DENY
    --
    +{static} fromString(raw)
  }
}

Arn --|> AbstractEmbeddable
Action --|> AbstractEmbeddable
Resource --|> AbstractEmbeddable
PrincipalId --|> AbstractEmbeddable
ReasonCode --|> AbstractEmbeddable

package "com.iam.identity.domain" as pkg_identity {
  class IamUser <<AggregateRoot>> {
    +username: String
    +email: String
    --
    +{static} create(username, email, passwordHash)
    +{static} createForFederatedLogin(provider, subject, email)
    +disable()
    +enable()
    +changeEmail(email)
    +assignRole(roleId)
    +hasRole(roleId)
    +assignedRoleIds()
    +encodedPasswordHash()
    +isLoginEnabled()
  }
  class Group <<AggregateRoot>> {
    +name: String
    --
    +{static} create(name)
    +arn()
    +addMember(userId)
    +removeMember(userId)
    +hasMember(userId)
    +memberUserIds()
  }
  class GroupMember <<Entity>> {
    +groupId: String
    +userId: String
    --
    +userId()
  }
  class UserRoleAssignment <<Entity>> {
    +userId: String
    +roleId: String
    --
    +roleId()
  }
  class Role <<AggregateRoot>> {
    +name: String
    +arn: Arn
    +trustPolicy: TrustPolicyDocument
    --
    +{static} create(name, trustPolicy)
    +arn()
    +trustPolicy()
    +authority()
  }
  class TrustPolicyDocument <<ValueObject>> {
    +json: String
    --
    +{static} allowAll()
  }
}

IamUser --|> AbstractEntity
Group --|> AbstractNamedEntity
Role --|> AbstractNamedEntity
TrustPolicyDocument --|> AbstractEmbeddable
Group "1" *-- "0..*" GroupMember : members
IamUser "1" *-- "0..*" UserRoleAssignment : roles
Role --> Arn
Role --> TrustPolicyDocument

package "com.iam.policy.domain" as pkg_policy {
  class PolicyDocument <<AggregateRoot>> {
    +name: String
    +statements: List<PolicyStatement>
    --
    +{static} create(name, statements)
    +statements()
  }
  class PolicyStatement <<ValueObject>> {
    +effect: Effect
    +actions: Set<Action>
    +resources: Set<Resource>
    --
    +{static} of(effect, actions, resources)
    +matches(action, resource)
  }
  class PolicyAttachment <<AggregateRoot>> {
    +policyId: String
    +principalArn: Arn
    --
    +{static} attach(policyId, principalArn)
    +policyId()
    +principalArn()
  }
  class PermissionPoint <<AggregateRoot>> {
    +code: String
    +oauthScope: Scope
    +module: String
    +action: Action
    +resource: Resource
    +description: String
    --
    +{static} create(code, oauthScope, module, action, resource, description)
    +oauthScope()
    +oauthScopeValue()
    +matchesScope(scope)
  }
  class EvaluationContext <<ValueObject>> {
    +principalId: PrincipalId
    +action: Action
    +resource: Resource
  }
  class AuthorizationDecision <<ValueObject>> {
    +effect: Effect
    +reasonCode: ReasonCode
    --
    +isAllowed()
  }
}

package "com.iam.policy.domain.service" as pkg_policy_svc {
  class PolicyEngine <<DomainService>> {
    +evaluate(context, policies)
  }
}

PolicyDocument --|> AbstractNamedEntity
PolicyAttachment --|> AbstractImmutable
PermissionPoint --|> AbstractImmutable
PolicyDocument "1" *-- "1..*" PolicyStatement : document_json
PolicyAttachment --> PolicyDocument : references policyId
PolicyAttachment --> Arn
PermissionPoint --> Action
PermissionPoint --> Resource
PermissionPoint --> Scope : oauthScope
EvaluationContext --> PrincipalId
EvaluationContext --> Action
EvaluationContext --> Resource
AuthorizationDecision --> Effect
AuthorizationDecision --> ReasonCode
PolicyEngine ..> PolicyDocument : reads
PolicyEngine ..> AuthorizationDecision : returns
PermissionPoint ..> PolicyEngine : catalog for Action/Resource

package "com.iam.sts.domain" as pkg_sts {
  class AssumedRoleSession <<AggregateRoot>> {
    +roleArn: Arn
    +sessionName: String
    +callerPrincipal: String
    +expiresAt: Instant
    --
    +{static} create(roleArn, sessionName, callerPrincipal, expiresAt)
    +isExpired(now)
    +roleArn()
    +sessionName()
    +callerPrincipal()
    +expiresAt()
  }
}

AssumedRoleSession --|> AbstractImmutable
AssumedRoleSession --> Arn

package "com.iam.federation.domain" as pkg_federation {
  class OidcClient <<AggregateRoot>> {
    +clientId: ClientId
    +redirectUris: Set<RedirectUri>
    +scopes: Set<Scope>
    --
    +{static} register(...)
    +{static} seed(...)
    +{static} seedPublic(...)
    +{static} reconstitute(...)
    +isPublicClient()
    +clientId()
    +redirectUris()
    +scopes()
    +scopeValues()
    +replaceScopes(scopes)
  }
  class FederatedIdentityLink <<AggregateRoot>> {
    +iamUserId: String
    +provider: String
    +externalSubject: String
    --
    +{static} create(iamUserId, provider, externalSubject)
    +linkedUserId()
  }
  class ClientId <<ValueObject>> {
    +value: String
  }
  class RedirectUri <<ValueObject>> {
    +value: String
  }
  note right of OidcClient
    Public clients (explore-ai-ios / explore-chat-ios):
    requireProofKey; custom-scheme RedirectUri
    (com.explore.*://oauth/callback) allowed.
    Scopes persist via SAS oauth2_registered_client.scopes.
  end note
}

FederatedIdentityLink --|> AbstractImmutable
ClientId --|> AbstractEmbeddable
RedirectUri --|> AbstractEmbeddable
OidcClient --> ClientId
OidcClient --> RedirectUri
OidcClient --> Scope : scopes
FederatedIdentityLink ..> IamUser : links

package "com.iam.audit.domain" as pkg_audit {
  class AuditActor <<ValueObject>> {
    +value: String
  }
  class AuditTarget <<ValueObject>> {
    +type: String
    +id: String
    --
    +matches(type, id)
  }
  class ManagementEvent <<AggregateRoot>> {
    +actor: AuditActor
    +action: String
    +target: AuditTarget
    +outcome: AuditOutcome
    --
    +{static} logManagementAction(actor, action, target, outcome)
    +{static} logAuthentication(actor, outcome)
    +wasSuccessful()
    +wasFailure()
    +involvesActor(candidate)
    +targets(candidate)
  }
  class AuthorizationDecisionLog <<AggregateRoot>> {
    +principalId: String
    +action: String
    +resource: String
    +effect: Effect
    +reasonCode: ReasonCode
    --
    +{static} capture(principalId, action, resource, effect, reasonCode)
    +{static} fromEvaluation(principalId, action, resource, effect, reasonCode)
    +isAllowed()
    +isDenied()
    +wasExplicitDeny()
    +wasImplicitDeny()
  }
  enum AuditOutcome <<Enum>> {
    SUCCESS
    FAILURE
  }
}

ManagementEvent --|> AbstractAuditEvent
AuthorizationDecisionLog --|> AbstractAuditEvent
ManagementEvent --> AuditActor
ManagementEvent --> AuditTarget
ManagementEvent --> AuditOutcome
AuthorizationDecisionLog --> PrincipalId
AuthorizationDecisionLog --> Action
AuthorizationDecisionLog --> Resource
AuthorizationDecisionLog --> Effect
AuthorizationDecisionLog --> ReasonCode
AuthorizationDecisionLog ..> AuthorizationDecision : captures

note as N_LAYERS
  Layering (per module): controller → service → domain ← infra
  Preferred Terms: docs/Glossary.md
end note

@enduml
