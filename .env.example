# Explore IAM local development
SERVER_PORT=9100
OIDC_ISSUER=http://localhost:9100

APP_DEMO_USER_ENABLED=true
APP_DEMO_USER_USERNAME=demo
APP_DEMO_USER_PASSWORD=demo-password
APP_DEMO_USER_EMAIL=demo@explore-iam.local

IAM_CLIENT_EXPLORE_AI_ID=explore-ai
IAM_CLIENT_EXPLORE_AI_SECRET=explore-ai-dev-secret
IAM_CLIENT_EXPLORE_AI_IOS_ID=explore-ai-ios
IAM_CLIENT_EXPLORE_CHAT_IOS_ID=explore-chat-ios

# SCIM: external IdPs call /scim/v2 with client_credentials (scope write:iam_scim).
# Leave blank to keep the client disabled; generate a long random value to enable.
IAM_CLIENT_SCIM_PROVISIONER_ID=scim-provisioner
IAM_CLIENT_SCIM_PROVISIONER_SECRET=

# SCIM push to Explore AI: IAM gets a client_credentials token (scope write:ai_scim)
# from itself and calls the target. Leave the URL blank to keep push disabled.
IAM_CLIENT_SCIM_OUTBOUND_ID=iam-scim-outbound
IAM_CLIENT_SCIM_OUTBOUND_SECRET=
EXPLORE_AI_SCIM_URL=
# Optional: only members of this IAM group are provisioned to Explore AI.
EXPLORE_AI_SCIM_ASSIGNMENT_GROUP=
