<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0.1-iam-users" author="explore-iam">
        <createTable tableName="iam_users">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="varchar(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="varchar(320)"/>
            <column name="password_hash" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-oauth2-registered-client" author="explore-iam">
        <createTable tableName="oauth2_registered_client">
            <column name="id" type="varchar(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="client_id_issued_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="client_secret" type="varchar(200)"/>
            <column name="client_secret_expires_at" type="timestamp"/>
            <column name="client_name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="client_authentication_methods" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="authorization_grant_types" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="redirect_uris" type="varchar(1000)"/>
            <column name="post_logout_redirect_uris" type="varchar(1000)"/>
            <column name="scopes" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="client_settings" type="varchar(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="token_settings" type="varchar(2000)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="oauth2_registered_client" indexName="idx_oauth2_registered_client_client_id">
            <column name="client_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="0.1-iam-signing-keys" author="explore-iam">
        <createTable tableName="iam_signing_keys">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_key_pem" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="private_key_pem" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-iam-groups" author="explore-iam">
        <createTable tableName="iam_groups">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-iam-group-memberships" author="explore-iam">
        <createTable tableName="iam_group_memberships">
            <column name="group_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="iam_group_memberships"
            columnNames="group_id, user_id"
            constraintName="pk_iam_group_memberships"/>
        <addForeignKeyConstraint baseTableName="iam_group_memberships"
            baseColumnNames="group_id"
            referencedTableName="iam_groups"
            referencedColumnNames="id"
            constraintName="fk_group_memberships_group"/>
        <addForeignKeyConstraint baseTableName="iam_group_memberships"
            baseColumnNames="user_id"
            referencedTableName="iam_users"
            referencedColumnNames="id"
            constraintName="fk_group_memberships_user"/>
    </changeSet>

    <changeSet id="0.1-iam-roles" author="explore-iam">
        <createTable tableName="iam_roles">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="arn" type="varchar(512)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="trust_policy_json" type="clob"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-iam-user-roles" author="explore-iam">
        <createTable tableName="iam_user_roles">
            <column name="user_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="iam_user_roles"
            columnNames="user_id, role_id"
            constraintName="pk_iam_user_roles"/>
        <addForeignKeyConstraint baseTableName="iam_user_roles"
            baseColumnNames="user_id"
            referencedTableName="iam_users"
            referencedColumnNames="id"
            constraintName="fk_user_roles_user"/>
        <addForeignKeyConstraint baseTableName="iam_user_roles"
            baseColumnNames="role_id"
            referencedTableName="iam_roles"
            referencedColumnNames="id"
            constraintName="fk_user_roles_role"/>
    </changeSet>

    <changeSet id="0.1-iam-policy-documents" author="explore-iam">
        <createTable tableName="iam_policy_documents">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(256)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="document_json" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-iam-policy-attachments" author="explore-iam">
        <createTable tableName="iam_policy_attachments">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="policy_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="principal_arn" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="iam_policy_attachments"
            baseColumnNames="policy_id"
            referencedTableName="iam_policy_documents"
            referencedColumnNames="id"
            constraintName="fk_policy_attachments_policy"/>
    </changeSet>

    <changeSet id="0.1-iam-assumed-role-sessions" author="explore-iam">
        <createTable tableName="iam_assumed_role_sessions">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role_arn" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="session_name" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="caller_principal" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-iam-federated-identity-links" author="explore-iam">
        <createTable tableName="iam_federated_identity_links">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="iam_user_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="external_subject" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="iam_federated_identity_links"
            columnNames="provider, external_subject"
            constraintName="uk_federated_provider_subject"/>
        <addForeignKeyConstraint baseTableName="iam_federated_identity_links"
            baseColumnNames="iam_user_id"
            referencedTableName="iam_users"
            referencedColumnNames="id"
            constraintName="fk_federated_identity_user"/>
    </changeSet>

    <changeSet id="0.1-iam-management-events" author="explore-iam">
        <createTable tableName="iam_management_events">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="actor" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="target_type" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-iam-authorization-decision-logs" author="explore-iam">
        <createTable tableName="iam_authorization_decision_logs">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="principal_id" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="resource" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="effect" type="varchar(8)">
                <constraints nullable="false"/>
            </column>
            <column name="reason_code" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
