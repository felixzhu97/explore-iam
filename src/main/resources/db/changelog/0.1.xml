<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0.1-directory-user" author="explore-iam">
        <createTable tableName="directory_user">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="varchar(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="varchar(320)"/>
            <column name="password_hash" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-oauth2-registered-client" author="explore-iam">
        <createTable tableName="oauth2_registered_client">
            <column name="id" type="varchar(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="client_id_issued_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="client_secret" type="varchar(200)"/>
            <column name="client_secret_expires_at" type="timestamp"/>
            <column name="client_name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="client_authentication_methods" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="authorization_grant_types" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="redirect_uris" type="varchar(1000)"/>
            <column name="post_logout_redirect_uris" type="varchar(1000)"/>
            <column name="scopes" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="client_settings" type="varchar(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="token_settings" type="varchar(2000)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="oauth2_registered_client" indexName="idx_oauth2_registered_client_client_id">
            <column name="client_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="0.1-signing-key-entity" author="explore-iam">
        <createTable tableName="signing_key_entity">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_key_pem" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="private_key_pem" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-group" author="explore-iam">
        <createTable tableName="group">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-group-member" author="explore-iam">
        <createTable tableName="group_member">
            <column name="group_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="group_member"
            columnNames="group_id, user_id"
            constraintName="pk_group_member"/>
        <addForeignKeyConstraint baseTableName="group_member"
            baseColumnNames="group_id"
            referencedTableName="group"
            referencedColumnNames="id"
            constraintName="fk_group_member_group"/>
        <addForeignKeyConstraint baseTableName="group_member"
            baseColumnNames="user_id"
            referencedTableName="directory_user"
            referencedColumnNames="id"
            constraintName="fk_group_member_user"/>
    </changeSet>

    <changeSet id="0.1-role" author="explore-iam">
        <createTable tableName="role">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="arn" type="varchar(512)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="trust_policy" type="clob"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-role-binding" author="explore-iam">
        <createTable tableName="role_binding">
            <column name="user_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="role_binding"
            columnNames="user_id, role_id"
            constraintName="pk_role_binding"/>
        <addForeignKeyConstraint baseTableName="role_binding"
            baseColumnNames="user_id"
            referencedTableName="directory_user"
            referencedColumnNames="id"
            constraintName="fk_role_binding_user"/>
        <addForeignKeyConstraint baseTableName="role_binding"
            baseColumnNames="role_id"
            referencedTableName="role"
            referencedColumnNames="id"
            constraintName="fk_role_binding_role"/>
    </changeSet>

    <changeSet id="0.1-allow-policy" author="explore-iam">
        <createTable tableName="allow_policy">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(256)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="statements" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-policy-binding" author="explore-iam">
        <createTable tableName="policy_binding">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="policy_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="principal_arn" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="policy_binding"
            baseColumnNames="policy_id"
            referencedTableName="allow_policy"
            referencedColumnNames="id"
            constraintName="fk_policy_binding_policy"/>
    </changeSet>

    <changeSet id="0.1-short-lived-credential" author="explore-iam">
        <createTable tableName="short_lived_credential">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role_arn" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="session_name" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="caller_principal" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-federated-identity" author="explore-iam">
        <createTable tableName="federated_identity">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="external_subject" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="federated_identity"
            columnNames="provider, external_subject"
            constraintName="uk_federated_provider_subject"/>
        <addForeignKeyConstraint baseTableName="federated_identity"
            baseColumnNames="user_id"
            referencedTableName="directory_user"
            referencedColumnNames="id"
            constraintName="fk_federated_identity_user"/>
    </changeSet>

    <changeSet id="0.1-admin-activity" author="explore-iam">
        <createTable tableName="admin_activity">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="actor" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="target_type" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-data-access-log" author="explore-iam">
        <createTable tableName="data_access_log">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="principal_id" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="resource" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="effect" type="varchar(8)">
                <constraints nullable="false"/>
            </column>
            <column name="reason_code" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-permission" author="explore-iam">
        <createTable tableName="permission">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(128)">
                <constraints nullable="false" unique="true"
                    uniqueConstraintName="uk_permission_code"/>
            </column>
            <column name="oauth_scope" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="module" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="resource" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
