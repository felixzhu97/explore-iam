<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0.1-iam-user" author="explore-iam">
        <createTable tableName="iam_user">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="varchar(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="varchar(320)"/>
            <column name="password_hash" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-oauth2-registered-client" author="explore-iam">
        <createTable tableName="oauth2_registered_client">
            <column name="id" type="varchar(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="client_id_issued_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="client_secret" type="varchar(200)"/>
            <column name="client_secret_expires_at" type="timestamp"/>
            <column name="client_name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="client_authentication_methods" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="authorization_grant_types" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="redirect_uris" type="varchar(1000)"/>
            <column name="post_logout_redirect_uris" type="varchar(1000)"/>
            <column name="scopes" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="client_settings" type="varchar(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="token_settings" type="varchar(2000)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="oauth2_registered_client" indexName="idx_oauth2_registered_client_client_id">
            <column name="client_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="0.1-signing-key-entity" author="explore-iam">
        <createTable tableName="signing_key_entity">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_key_pem" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="private_key_pem" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-group" author="explore-iam">
        <createTable tableName="group">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-group-member" author="explore-iam">
        <createTable tableName="group_member">
            <column name="group_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="group_member"
            columnNames="group_id, user_id"
            constraintName="pk_group_member"/>
        <addForeignKeyConstraint baseTableName="group_member"
            baseColumnNames="group_id"
            referencedTableName="group"
            referencedColumnNames="id"
            constraintName="fk_group_member_group"/>
        <addForeignKeyConstraint baseTableName="group_member"
            baseColumnNames="user_id"
            referencedTableName="iam_user"
            referencedColumnNames="id"
            constraintName="fk_group_member_user"/>
    </changeSet>

    <changeSet id="0.1-role" author="explore-iam">
        <createTable tableName="role">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="arn" type="varchar(512)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="trust_policy_json" type="clob"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-user-role-assignment" author="explore-iam">
        <createTable tableName="user_role_assignment">
            <column name="user_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_role_assignment"
            columnNames="user_id, role_id"
            constraintName="pk_user_role_assignment"/>
        <addForeignKeyConstraint baseTableName="user_role_assignment"
            baseColumnNames="user_id"
            referencedTableName="iam_user"
            referencedColumnNames="id"
            constraintName="fk_user_role_assignment_user"/>
        <addForeignKeyConstraint baseTableName="user_role_assignment"
            baseColumnNames="role_id"
            referencedTableName="role"
            referencedColumnNames="id"
            constraintName="fk_user_role_assignment_role"/>
    </changeSet>

    <changeSet id="0.1-policy-document" author="explore-iam">
        <createTable tableName="policy_document">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(256)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="document_json" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-policy-attachment" author="explore-iam">
        <createTable tableName="policy_attachment">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="policy_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="principal_arn" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="policy_attachment"
            baseColumnNames="policy_id"
            referencedTableName="policy_document"
            referencedColumnNames="id"
            constraintName="fk_policy_attachment_policy"/>
    </changeSet>

    <changeSet id="0.1-assumed-role-session" author="explore-iam">
        <createTable tableName="assumed_role_session">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role_arn" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="session_name" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="caller_principal" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-federated-identity-link" author="explore-iam">
        <createTable tableName="federated_identity_link">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="iam_user_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="external_subject" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="federated_identity_link"
            columnNames="provider, external_subject"
            constraintName="uk_federated_provider_subject"/>
        <addForeignKeyConstraint baseTableName="federated_identity_link"
            baseColumnNames="iam_user_id"
            referencedTableName="iam_user"
            referencedColumnNames="id"
            constraintName="fk_federated_identity_user"/>
    </changeSet>

    <changeSet id="0.1-management-event" author="explore-iam">
        <createTable tableName="management_event">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="actor" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="target_type" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="0.1-authorization-decision-log" author="explore-iam">
        <createTable tableName="authorization_decision_log">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="principal_id" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="resource" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="effect" type="varchar(8)">
                <constraints nullable="false"/>
            </column>
            <column name="reason_code" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
