@startuml C4-Deployment-Production
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title 部署图 — 生产目标（Explore IAM，计划）

Deployment_Node(edge, "边缘 / CDN", "HTTPS 终结") {
    Container(console_cdn, "IAM Console", "Angular 22 静态资源", "CDN / 对象存储")
}

Deployment_Node(app_tier, "应用层", "容器编排") {
    Container(control_plane, "Control Plane API", "Spring Boot 4.1 / Java 25", "Identity / Policy / AuthZ / Audit")
    Container(oidc_provider, "OIDC Provider", "Spring Authorization Server", "issuer 公网可达")
    Container(policy_engine, "Policy Engine", "可水平扩展", "策略求值")
    Container(sts, "STS", "与 Control Plane 同集群", "临时凭证")
}

Deployment_Node(data_tier, "数据层", "托管服务") {
    ContainerDb(postgres, "PostgreSQL", "托管", "元数据；审计可分库")
    ContainerDb(redis, "Redis", "托管（可选）", "会话 / 限流")
    Container(audit_sink, "审计归档", "对象存储 / SIEM", "长期保留")
}

System_Ext(external_idp, "外部 IdP", "Google / GitHub", "联邦")
System_Ext(apps, "业务应用", "Relying Party", "OIDC 客户端")

Rel(console_cdn, control_plane, "REST", "HTTPS")
Rel(apps, oidc_provider, "OIDC", "HTTPS")
Rel(apps, control_plane, "可选鉴权 API", "HTTPS")
Rel(control_plane, policy_engine, "内网")
Rel(control_plane, sts, "内网")
Rel(control_plane, oidc_provider, "内网")
Rel(control_plane, postgres, "SQL")
Rel(control_plane, redis, "可选")
Rel(control_plane, audit_sink, "导出审计")
Rel(oidc_provider, external_idp, "联邦", "HTTPS")
Rel(oidc_provider, postgres, "SQL")

@enduml
