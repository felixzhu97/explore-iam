@startuml C1-Context
!theme C4_blue_new from https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/themes
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context (C1) — Explore IAM

Person(end_user, "End User", "Uses business apps via SSO")
Person(developer, "App Developer", "Registers Relying Parties; integrates OIDC")
Person(admin, "IAM Administrator", "Manages users, groups, roles, policies, audit")

System_Boundary(explore_iam, "Explore IAM") {
    System(iam_platform, "Explore IAM Platform", "Identity, Policy, STS, OIDC Provider, Audit (AWS IAM–style)")
}

System_Ext(google_idp, "Google IdP", "External OIDC / OAuth federation")
System_Ext(github_idp, "GitHub IdP", "External OAuth federation")
System_Ext(explore_ai, "Explore AI", "Relying Party")
System_Ext(whatsfeed, "WhatsFeed", "Relying Party")
System_Ext(shopping, "Shopping System", "Relying Party")
System_Ext(low_code, "Low Code Platform", "Relying Party")

Rel(end_user, explore_ai, "Uses", "HTTPS")
Rel(end_user, whatsfeed, "Uses", "HTTPS")
Rel(end_user, shopping, "Uses", "HTTPS")
Rel(end_user, low_code, "Uses", "HTTPS")
Rel(end_user, iam_platform, "Login / consent", "HTTPS / OIDC")
Rel(admin, iam_platform, "Manage identity & policy", "HTTPS")
Rel(developer, iam_platform, "Register clients", "HTTPS / REST")

Rel(explore_ai, iam_platform, "OIDC login / token / AuthZ", "OIDC / HTTPS")
Rel(whatsfeed, iam_platform, "OIDC login / token / AuthZ", "OIDC / HTTPS")
Rel(shopping, iam_platform, "OIDC login / token / AuthZ", "OIDC / HTTPS")
Rel(low_code, iam_platform, "OIDC login / token / AuthZ", "OIDC / HTTPS")

Rel(iam_platform, google_idp, "Federated auth", "OIDC")
Rel(iam_platform, github_idp, "Federated auth", "OAuth 2.0")

SHOW_LEGEND()

@enduml
